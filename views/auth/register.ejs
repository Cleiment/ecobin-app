<section class="auth-card">
  <h1 class="auth-title">Buat akun EcoBin</h1>
  <p class="auth-lead">Setelah daftar, kamu langsung dapat QR membership untuk setor sampah di stasiun EcoBin.</p>

  <form class="form-stack" method="post" action="/daftar" novalidate>
    <div class="field">
      <label for="name">Nama lengkap</label>
      <input id="name" name="name" type="text" autocomplete="name" value="<%= values.name || '' %>" required
        <% if (errors.name) { %>aria-invalid="true" aria-describedby="name-error"<% } %>>
      <% if (errors.name) { %><p class="field-error" id="name-error"><%= errors.name %></p><% } %>
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" value="<%= values.email || '' %>" required
        <% if (errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>>
      <% if (errors.email) { %><p class="field-error" id="email-error"><%= errors.email %></p><% } %>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required
        aria-describedby="password-hint<%= errors.password ? ' password-error' : '' %>"
        <% if (errors.password) { %>aria-invalid="true"<% } %>>
      <p class="field-hint" id="password-hint">Minimal 8 karakter.</p>
      <% if (errors.password) { %><p class="field-error" id="password-error"><%= errors.password %></p><% } %>
    </div>
    <button class="btn btn--primary btn--block" type="submit">Daftar</button>
  </form>

  <p class="auth-switch">Sudah punya akun? <a href="/masuk">Masuk</a></p>
</section>
