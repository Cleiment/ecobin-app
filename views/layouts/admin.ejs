<%
  const links = [
    { href: "/admin", label: "Dashboard", icon: "grid", exact: true },
    { href: "/admin/stasiun", label: "Simulator Stasiun", icon: "monitor" },
    { href: "/admin/setoran", label: "Riwayat Setoran", icon: "list" },
    { href: "/admin/penukaran", label: "Penukaran Voucher", icon: "receipt" },
    { href: "/admin/kategori", label: "Kategori Sampah", icon: "tag" },
    { href: "/admin/voucher", label: "Voucher", icon: "ticket" },
    { href: "/admin/lokasi", label: "Lokasi dan Unit", icon: "store" },
    { href: "/admin/pengguna", label: "Pengguna", icon: "users" }
  ];
  const isActive = (link) => link.exact ? (path === link.href || path === link.href + "/") : path.startsWith(link.href);
%>
<!doctype html>
<html lang="id">
<head>
  <%- include('../partials/head') %>
</head>
<body class="shell-admin">
  <%- include('../partials/icons') %>
  <a class="skip-link" href="#main">Lewati ke konten</a>

  <header class="a-topbar">
    <a href="/admin" aria-label="Dashboard EcoBin">
      <img src="/img/logo/ecobin-horizontal-reversed.svg" alt="" width="112" height="27">
    </a>
    <button class="icon-btn icon-btn--dark" type="button" aria-expanded="false" aria-controls="admin-nav" data-nav-toggle>
      <svg class="icon" aria-hidden="true"><use href="#i-menu"/></svg>
      <span class="visually-hidden">Buka menu</span>
    </button>
  </header>

  <aside class="a-side" id="admin-nav" data-nav>
    <a class="a-brand" href="/admin" aria-label="Dashboard EcoBin">
      <img src="/img/logo/ecobin-horizontal-reversed.svg" alt="" width="132" height="32">
      <span class="a-brand-tag">Pengelola</span>
    </a>
    <nav aria-label="Menu pengelola">
      <ul class="a-nav">
        <% links.forEach((link) => { %>
          <li>
            <a href="<%= link.href %>"<% if (isActive(link)) { %> aria-current="page"<% } %>>
              <svg class="icon" aria-hidden="true"><use href="#i-<%= link.icon %>"/></svg>
              <%= link.label %>
            </a>
          </li>
        <% }) %>
      </ul>
    </nav>
    <div class="a-account">
      <span class="avatar avatar--sm" aria-hidden="true"><%= fmt.initials(currentUser.name) %></span>
      <span class="a-account-name"><%= currentUser.name %></span>
      <form method="post" action="/keluar">
        <button class="icon-btn icon-btn--dark" type="submit">
          <svg class="icon" aria-hidden="true"><use href="#i-logout"/></svg>
          <span class="visually-hidden">Keluar</span>
        </button>
      </form>
    </div>
  </aside>

  <main class="a-main" id="main">
    <%- include('../partials/flash') %>
    <%- body %>
  </main>
</body>
</html>
