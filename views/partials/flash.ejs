<% if (flash) { %>
  <div class="alert alert--<%= flash.type === 'error' ? 'error' : 'success' %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
    <svg class="icon" aria-hidden="true"><use href="#i-<%= flash.type === 'error' ? 'alert' : 'check' %>"/></svg>
    <p><%= flash.message %></p>
  </div>
<% } %>
